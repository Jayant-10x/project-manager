APP_NAME="Project Manager 10X Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project-manager
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email-address@email.com
MAIL_PASSWORD=app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@email.in"
MAIL_FROM_NAME="10X Agency PJT CRM"

CRM_APP_SHORT="PJT CRM"
CRM_SESSION_TTL=604800
CRM_RESET_TTL=7200
CRM_MAX_LOGIN_FAILS=5
CRM_LOCK_MINUTES=30
CRM_PAYMENT_ALERT_DAYS=7
CRM_AMC_ALERT_DAYS=7
CRM_FOLLOWUP_ALERT_DAYS=1
CRM_MAX_UPLOAD_KB=10240
CRM_ALLOWED_UPLOAD_EXT="pdf,jpg,jpeg,png,gif,webp,doc,docx,xls,xlsx,csv,txt,ppt,pptx,zip"
